<PageTitle>Sign Document</PageTitle>


<button class="btn btn-primary" @onclick="SignDocumentInSpecificField">Podpisz dokument</button>

<label>Pole nr:</label>
<input type="number" step="1" min="0" max="3" @bind="signFieldNumber" />

<button class="btn btn-primary" @onclick="AddSignatureField">Utwórz pole podpisu</button>
<select @bind="positionSelected">
    @foreach (var item in positions.Keys)
    {
        <option value="@item">@item</option>
    }
</select>
<input type="checkbox" @onclick="IsCheckedChanged" />
<label>Dodaj do tego samego dokumentu</label>


@code {
    private static int count = 0;
    private static int signFieldNumber = 0;
    private static bool IsChecked { get; set; }
    private static Dictionary<string, (float X, float Y)> positions = new Dictionary<string, (float X, float Y)>
    {
        { "Lewy górny róg", (70,692) },
        { "Prawy górny róg", (420,692) },
        { "Lewy dolny róg", (70,70) },
        { "Prawy dolny róg", (432,70)},
    };
    private static string positionSelected = "Lewy górny róg";

    private static string tempFilePath = System.IO.Path.GetTempFileName();
    private static string inputPdf = "C:/Users/plk081284/Desktop/Podpis.pdf";
    private static string outputPdf = "C:/Users/plk081284/Desktop/signed-document.pdf";
    private static string generatedInputPdf = "";
    private static string certificatePath = "C:/Users/plk081284/AppData/Roaming/Adobe/Acrobat/DC/Security/DanielPrzewoźny.pfx";
    private static string certificatePassword = "qwe123QWE!@#";

    static void SignDocument()
    {
        // Załaduj certyfikat PFX
        X509Certificate2 cert = new X509Certificate2(certificatePath, certificatePassword, X509KeyStorageFlags.Exportable);

        // Pobierz klucz prywatny
        RSA rsa = cert.GetRSAPrivateKey();
        if (rsa == null)
        {
            return;
        }

        var keyPair = DotNetUtilities.GetKeyPair(rsa);
        AsymmetricKeyParameter privateKeyParam = keyPair.Private;

        // Konwersja certyfikatu do tablicy X509Certificate
        var bcCert = DotNetUtilities.FromX509Certificate(cert);
        IX509Certificate[] chain = { new X509CertificateBC(bcCert) };
        IPrivateKey privateKey = new PrivateKeyBC(DotNetUtilities.GetKeyPair(rsa).Private);

        using (PdfReader reader = new PdfReader(inputPdf))
        using (PdfWriter writer = new PdfWriter(outputPdf))
        {
            PdfSigner signer = new PdfSigner(reader, writer, new StampingProperties().UseAppendMode());

            // Zdefiniowanie rozmiaru strony
            var firstPage = signer.GetDocument().GetFirstPage();
            var pageSize = firstPage.GetPageSize();

            // Ustawienie właściwości podpisu cyfrowego
            // Ustaw nazwę pola podpisu – to tworzy widoczny obszar podpisu w formularzu PDF
            signer.SetSignerProperties(new SignerProperties()
                .SetSignatureAppearance(new SignatureFieldAppearance("DigitalSignature3")
                .SetContent("Podpis cyfrowy\n" + DateTime.Now.ToString("yyyy.MM.dd HH:mm")))
                .SetFieldName("DigitalSignature3")
                .SetReason("Podpis cyfrowy")
                .SetLocation("Gdańsk, Polska")
                .SetPageRect(new Rectangle(pageSize.GetLeft() + 70, pageSize.GetTop() - 150, 100, 50))
                .SetPageNumber(1)
                );

            IExternalSignature pks = new PrivateKeySignature(privateKey, DigestAlgorithms.SHA256);
            IExternalDigest digest = new BouncyCastleDigest();

            signer.SignDetached(digest, pks, chain, null, null, null, 0, PdfSigner.CryptoStandard.CMS);
        }
    }

    static void SignDocumentInSpecificField()
    {
        // Załaduj certyfikat PFX
        X509Certificate2 cert = new X509Certificate2(certificatePath, certificatePassword, X509KeyStorageFlags.Exportable);

        // Pobierz klucz prywatny
        RSA rsa = cert.GetRSAPrivateKey();
        if (rsa == null)
        {
            return;
        }

        var keyPair = DotNetUtilities.GetKeyPair(rsa);
        AsymmetricKeyParameter privateKeyParam = keyPair.Private;

        // Konwersja certyfikatu do tablicy X509Certificate
        var bcCert = DotNetUtilities.FromX509Certificate(cert);
        IX509Certificate[] chain = { new X509CertificateBC(bcCert) };
        IPrivateKey privateKey = new PrivateKeyBC(DotNetUtilities.GetKeyPair(rsa).Private);

        using (PdfReader reader = new PdfReader(inputPdf))
        using (PdfWriter writer = new PdfWriter(tempFilePath))
        {
            PdfSigner signer = new PdfSigner(reader, writer, new StampingProperties().UseAppendMode());

            // Zdefiniowanie rozmiaru strony
            var firstPage = signer.GetDocument().GetFirstPage();
            var pageSize = firstPage.GetPageSize();

            signer.SetSignerProperties(new SignerProperties().SetFieldName("DigitalSignature" + signFieldNumber.ToString())
            .SetSignatureAppearance(new SignatureFieldAppearance("DigitalSignature" + signFieldNumber.ToString())
                 .SetContent("Podpis cyfrowy\n" + DateTime.Now.ToString("yyyy.MM.dd HH:mm"))))
            .GetSignatureField();

            IExternalSignature pks = new PrivateKeySignature(privateKey, DigestAlgorithms.SHA256);
            IExternalDigest digest = new BouncyCastleDigest();

            signer.SignDetached(digest, pks, chain, null, null, null, 0, PdfSigner.CryptoStandard.CMS);

            signer.GetDocument().Close();
        }
        File.Copy(tempFilePath, inputPdf, true);
        File.Delete(tempFilePath);
    }

    static void AddToNewPdfFile()
    {
        using (PdfReader reader = new PdfReader(inputPdf))
        using (PdfWriter writer = new PdfWriter(outputPdf))
        {
            PdfDocument pdfDoc = new PdfDocument(reader, writer, new StampingProperties().UseAppendMode());
            PdfPage page = pdfDoc.GetFirstPage();
            var pageSize = page.GetPageSize();
            var signX = positions[positionSelected].X;
            var signXtest = pageSize.GetRight() + 70;
            var signY = positions[positionSelected].Y;
            var signYtest = pageSize.GetTop() - 150;
            var signDescritpion = "DigitalSignature" + count.ToString();
            ++count;
            Rectangle rect = new Rectangle(signX, signY, 100, 50);
            var annotation = new PdfWidgetAnnotation(rect);
            annotation.Put(PdfName.Type, PdfName.Annot); //Typ: Adnotacja
            annotation.Put(PdfName.Subtype, PdfName.Widget);//Podtyp: widget
            annotation.Put(PdfName.Rect, new PdfArray(rect)); //wymiary pola
            annotation.Put(PdfName.FT, PdfName.Sig); //Typ: sygnatura
            annotation.Put(PdfName.T, new PdfString(signDescritpion)); //Nazwa pola

            // PdfCanvas canvas = new PdfCanvas(page);
            // canvas.BeginText()
            //     .SetFontAndSize(PdfFontFactory.CreateFont(StandardFonts.HELVETICA), 10)
            //     .SetFillColor(ColorConstants.BLACK)
            //     .MoveText(signX, signY + 20)
            //     .ShowText(signDescritpion)
            //     .EndText();

            var obj = annotation.MakeIndirect(pdfDoc);
            page.AddAnnotation(annotation);

            PdfFormField signatureField = PdfFormField.MakeFormField(obj.GetPdfObject(), pdfDoc);
            signatureField.SetFieldName(signDescritpion);
            PdfAcroForm form = PdfAcroForm.GetAcroForm(pdfDoc, true);
            form.SetNeedAppearances(true);
            form.AddField(signatureField, page);
            pdfDoc.Close();
        }
    }

    static void AddToTheSamePdfFile()
    {   
        using (PdfReader reader = new PdfReader(inputPdf))
        using (PdfWriter writer = new PdfWriter(tempFilePath))
        using (PdfDocument pdfDoc = new PdfDocument(reader, writer))
        {
            PdfPage page = pdfDoc.GetFirstPage();
            var pageSize = page.GetPageSize();
            var signX = positions[positionSelected].X;
            var signXtest = pageSize.GetRight() + 70;
            var signY = positions[positionSelected].Y;
            var signYtest = pageSize.GetTop() - 150;
            var signDescritpion = "DigitalSignature" + count.ToString();
            ++count;
            Rectangle rect = new Rectangle(signX, signY, 100, 50);
            var annotation = new PdfWidgetAnnotation(rect);
            annotation.Put(PdfName.Type, PdfName.Annot); //Typ: Adnotacja
            annotation.Put(PdfName.Subtype, PdfName.Widget);//Podtyp: widget
            annotation.Put(PdfName.Rect, new PdfArray(rect)); //wymiary pola
            annotation.Put(PdfName.FT, PdfName.Sig); //Typ: sygnatura
            annotation.Put(PdfName.T, new PdfString(signDescritpion)); //Nazwa pola

            // PdfCanvas canvas = new PdfCanvas(page);
            // canvas.BeginText()
            //     .SetFontAndSize(PdfFontFactory.CreateFont(StandardFonts.HELVETICA), 10)
            //     .SetFillColor(ColorConstants.BLACK)
            //     .MoveText(signX, signY + 20)
            //     .ShowText(signDescritpion)
            //     .EndText();

            var obj = annotation.MakeIndirect(pdfDoc);
            page.AddAnnotation(annotation);

            PdfFormField signatureField = PdfFormField.MakeFormField(obj.GetPdfObject(), pdfDoc);
            signatureField.SetFieldName(signDescritpion);
            PdfAcroForm form = PdfAcroForm.GetAcroForm(pdfDoc, true);

            form.SetNeedAppearances(true);
            form.AddField(signatureField, page);
            pdfDoc.Close();
            writer.Close();
            reader.Close();
        }
        File.Copy(tempFilePath, inputPdf, true);
        File.Delete(tempFilePath);
    }

    private static void IsCheckedChanged()
    {
        IsChecked = !IsChecked;
        count = 0;
    }

    private static void AddSignatureField()
    {
        if (IsChecked)
        {
            AddToTheSamePdfFile();
        }
        else
        {
            AddToNewPdfFile();
        }
    }
}
